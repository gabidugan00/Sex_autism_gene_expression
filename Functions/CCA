#GO database
go.gs = get_GeneOntology(to="SYMBOL")

GO_terms <- list()
for(i in 1:length(go.gs)){
  GO_terms[[i]] <- go.gs[[i]]@geneIds
}
names(GO_terms) <- names(go.gs)

go_ids <- keys(GO.db)
categories <- sapply(GOTERM, function(x) {
  if (!is.null(Ontology(x))) Ontology(x) else NA
})

names <- sapply(GOTERM, function(x) {
  if (!is.null(Term(x))) Term(x) else NA
})

# Ensure all vectors are the same length
stopifnot(length(go_ids) == length(categories), length(go_ids) == length(names))

# Create the data frame
go_terms_df <- data.frame(
  pathway = go_ids,
  category = categories,
  name = names,
  stringsAsFactors = FALSE
) %>%
  dplyr::filter(!is.na(category)) %>%
  mutate(category = case_when(
    category == "CC" ~ "Cellular Component",
    category == "BP" ~ "Biological Process",
    category == "MF" ~ "Molecular Function",
    TRUE ~ "Other"
  ))

GO_ID_full <- sub(":","", go_terms_df$pathway)
GO_ID <- sub(".*GO","", GO_ID_full)
GO_ID_edit <- paste("GO", GO_ID, sep = "")
GO_ID_edit <- paste(GO_ID_edit, go_terms_df$name, sep =": ")
