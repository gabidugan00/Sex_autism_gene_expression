prepare_observed_strcor <- function(strcor_df,
                                    dataset,
                                    brainregion = NULL,
                                    annotator_fn) {
  df <- data.frame(
    StrCor = as.numeric(strcor_df[,1]),
    Celltype = rownames(strcor_df),
    Dataset =dataset ,
    stringsAsFactors = FALSE
  )
  
  if (!is.null(brainregion)) {
    df$brainregion <- brainregion
  } else {
    df$brainregion <- sub(".*\\.", "", df$Celltype)
    df$Celltype <- sub("\\..*", "", df$Celltype)
  }
  
  df$broad_celltype <- annotator_fn(df$Celltype)
  df$Brainregion_short <- annotate_brainregion_short(df$brainregion)
  
  df
}


scatter_specific_genes_cca = function(CCA_weights, 
                                      genelists, 
                                      color_variable = "SC", 
                                      colors_vector,
                                      alpha_vector,
                                      size_vector,
                                      shape_vector,
                                      color_label, 
                                      title) {
  df <- CCA_weights
  
  df[[color_variable]] <- "Default"  
  
  for (i in names(genelists)) {
    df[[color_variable]][df$gene %in% genelists[[i]]] <- i
  }
  
  df[[color_variable]] <- factor(df[[color_variable]], levels = names(colors_vector))
  
  p_scatter <- ggplot(df, aes(x = CCA1_Score_Sex, y = CCA1_Score_ASD)) +
    theme_minimal() +
    geom_point(aes(color = .data[[color_variable]], alpha = .data[[color_variable]],  size = .data[[color_variable]], fill = .data[[color_variable]])) +
    geom_text_repel(data = df[df[[color_variable]] != "Default", ],aes(label = gene, color = .data[[color_variable]]),size = 5,max.overlaps = 30,box.padding = 0.3) +
    labs(title =title,x = "Sex Score",y = "Autism Score",color = color_label) +
    scale_color_manual(values = colors_vector) +
    scale_fill_manual(values = colors_vector) +
    scale_alpha_manual(values = alpha_vector) +
    scale_size_manual(values = size_vector) +
    scale_shape_manual(values = shape_vector) +
    theme(plot.title = element_text(hjust = 0.5, size = 30, face = "bold"),plot.subtitle = element_text(hjust = 0.5, size = 15)) +
    geom_smooth(method = "lm", formula = y ~ x, linetype = 0) +
    geom_hline(yintercept = 0, color = "grey40") +
    geom_vline(xintercept = 0, color = "grey40") +
    geom_abline(slope = 1, intercept = 0, linetype = "dotted", color = "grey40")
  
  return(p_scatter)
}

