specific_gene_heatmap = function(CCA1_weights_df, genelist){
  
  subset_df <- CCA1_weights_df[CCA1_weights_df$gene %in% genelist,]
  
  median_score = data.frame(lapply(subset_df[,c("CCA1_Weight_Sex","CCA1_Weight_ASD","mean_score")], median))
  median_score = pivot_longer(median_score, col=c("CCA1_Weight_Sex","CCA1_Weight_ASD","mean_score"))
  
  subset_df = pivot_longer(subset_df, col=c("CCA1_Weight_Sex","CCA1_Weight_ASD","mean_score"))
  
  subset_df$median_score = median_score$value[match(subset_df$name,median_score$name)]
  subset_df$name = sub("CCA1_Weight_ASD","Median\nAutism\nScore",subset_df$name)
  subset_df$name = sub("CCA1_Weight_Sex","Median\nSex\nScore",subset_df$name)
  subset_df$name = sub("mean_score","Median\nCombined\nScore",subset_df$name)
  
  subset_df$name  = factor(subset_df$name, levels =c("Median\nSex\nScore","Median\nAutism\nScore","Median\nCombined\nScore"))
  
  p = ggplot(subset_df, aes(x = name,y =1, fill = median_score)) +
    theme_cowplot() +
    geom_tile() +
    labs(title = "",x = "CCA1 Score List", y = "", fill="Median Score") +
    scale_fill_gradientn(colors = c("#01665e", "#f7f7f7", "#b35806"),values = rescale(c(-5, 0, 8)),limits = c(-5, 8),oob = squish) +
    theme(plot.title = element_text(hjust = 0.5, size = 20, face = "bold"),
          plot.subtitle = element_text(hjust = 0.5, size = 15),
          axis.title = element_text(size = 15),
          axis.text.x= element_text(size =12,angle =45, hjust =1),
          axis.text.y= element_text(size=0),
          legend.position = "right")
  
  return(p)
  
}

