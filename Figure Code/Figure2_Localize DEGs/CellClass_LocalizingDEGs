  mutate(
    ASD_celltype = sub("BEC_Endo", "NeuVasc", ASD_celltype),
    Sex_celltype = sub("BEC_Endo", "NeuVasc", Sex_celltype)
  )

perm_df_filt <- perm_df %>%
  mutate(Full = paste(ASD_celltype, Sex_celltype, sep = "_")) %>%
  dplyr::filter(Full %in% valid_keys$Full) %>%
  mutate(
    a_perm    = overlap_genes,
    b         = total_ASD_DEGs - overlap_genes,
    c_perm    = total_Sex_DEGs - overlap_genes,
    d         = total_background - (a_perm + b + c_perm),
    perm_OR   = ((a_perm + 0.5) * (d + 0.5)) / ((b + 0.5) * (c_perm + 0.5)),
    perm_logOR = log(perm_OR)
  )

# some permutations showed 0 DEGs, but these need to be included as permutations, rather than dropped
# When sex has 0 DEGs for a region-cell type permutation, that combo is dropped from output; pad with empty rows so each combo reaches exactly 1000
replicable_info <- fishers_test_broad %>%
  dplyr::filter(overlap_genes > 0) %>%
  dplyr::select(ASD_celltype, Sex_celltype, total_ASD_DEGs, total_background)

perm_padded <- perm_df_filt %>%
  dplyr::count(ASD_celltype, Sex_celltype, name = "n_perm") %>%
  left_join(replicable_info, by = c("ASD_celltype", "Sex_celltype")) %>%
  mutate(n_missing = pmax(0, 1000 - n_perm)) %>%
  mutate(extra_rows = purrr::pmap(
    list(ASD_celltype, Sex_celltype, n_missing, total_ASD_DEGs, total_background),
    function(ac, sc, nm, asd_total, bg) {
      nm <- as.integer(nm)
      if (nm == 0) return(NULL)
      row <- tibble(
        ASD_celltype   = ac,
        Sex_celltype   = sc,
        overlap_genes  = 0,
        total_ASD_DEGs = asd_total,
        total_Sex_DEGs = 0,
        total_background = bg,
        a_perm   = 0,
        b        = asd_total,
        c_perm   = 0,
        d        = bg - asd_total,
        perm_OR  = ((0 + 0.5) * (bg - asd_total + 0.5)) / ((asd_total + 0.5) * (0 + 0.5)),
        perm_logOR = log(perm_OR)
      )
      bind_rows(replicate(nm, row, simplify = FALSE))
    }
  ))

perm_df_filt_complete <- bind_rows(
  perm_df_filt,
  bind_rows(perm_padded$extra_rows)
)

# Empirical p-values comparing permutations to original
empirical_pvals_auto <- perm_df_filt_complete %>%
  inner_join(obs_df %>% dplyr::select(ASD_celltype, Sex_celltype, a_obs),
             by = c("ASD_celltype", "Sex_celltype")) %>%
  mutate(extreme = a_perm >= a_obs) %>%
  dplyr::group_by(ASD_celltype, Sex_celltype) %>%
  dplyr::summarise(
    n_perm      = n(),
    p_empirical = (sum(extreme) + 1) / (n_perm + 1),
    .groups     = "drop"
  ) %>%
  left_join(obs_df, by = c("ASD_celltype", "Sex_celltype")) %>%
  mutate(
    Sex_BroadCelltype = sub("\\..*", "", Sex_celltype),
    Sex_Brainregion   = sub(".*\\.", "", Sex_celltype),
    Sig               = p_empirical < 0.05,
    Sex_Brainregion   = factor(Sex_Brainregion,   levels = brain_regions),
    ASD_celltype      = factor(ASD_celltype,       levels = asd_celltypes),
    Sex_BroadCelltype = factor(Sex_BroadCelltype,  levels = rev(sex_celltypes))
  )

