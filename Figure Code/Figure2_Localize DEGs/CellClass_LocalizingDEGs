    Sex_BroadCelltype = factor(Sex_BroadCelltype, levels = rev(sex_celltypes))
  )

#original test of overlap
obs_df <- fishers_test_broad %>%
  dplyr::filter(overlap_genes > 0) %>%
  dplyr::select(ASD_celltype, Sex_celltype, p_value, odds_ratio,
                total_background, total_ASD_DEGs, total_Sex_DEGs, overlap_genes) %>%
  mutate(
    a_obs    = overlap_genes,
    b_obs    = total_ASD_DEGs - a_obs,
    c_obs    = total_Sex_DEGs - a_obs,
    d_obs    = total_background - (a_obs + b_obs + c_obs),
    obs_OR   = ((a_obs + 0.5) * (d_obs + 0.5)) / ((b_obs + 0.5) * (c_obs + 0.5)),
    obs_logOR = log(obs_OR)
  ) %>%
  dplyr::select(ASD_celltype, Sex_celltype, obs_OR, obs_logOR,
                a_obs, b_obs, c_obs, d_obs)

valid_keys <- obs_df %>%
