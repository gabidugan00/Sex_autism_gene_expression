#G0 enrichments
sig_go_specific <- fgseaRes_mean %>%
  dplyr::filter(dataset == "GO") %>%
  dplyr::left_join(go_terms_df, by = "pathway") %>%
  dplyr::mutate(category = ifelse(is.na(category), "Other", category)) %>%
  dplyr::filter(category == "Biological Process", padj < 0.05)

top10_pathways <- bind_rows(
  sig_go_specific %>% group_by(category) %>% slice_max(order_by = NES, n = 8),
  sig_go_specific %>% group_by(category) %>% slice_min(order_by = NES, n = 8)
) %>%
  ungroup() %>%
  mutate(term = sub(".*: ", "", pathway))

cutdown_top10 <- sig_go_specific %>%
  dplyr::filter(name %in% top10_pathways$name) %>%
  dplyr::mutate(
    significant      = padj < 0.05,
    color_significant = ifelse(significant, "black", NA),
    Direction         = factor(ifelse(NES < 0, "Negative", "Positive"),
                               levels = c("Positive", "Negative"))
  ) %>%
  dplyr::arrange(desc(NES)) %>%
  dplyr::mutate(name = factor(name, levels = rev(unique(name))))

#Risk genes enrichments
risk_specific <- fgseaRes_mean %>%
  dplyr::filter(dataset == "Risk",
                !grepl("Rare",pathway)) %>%
  mutate(name = str_wrap(pathway, width = 30))

risk_specific <- risk_specific %>% filter(name %in% str_wrap(pathway_order, width =30))

fgsea_f <- bind_rows(cutdown_top10, risk_specific) %>%
  mutate(
    significant = padj < 0.05,
    name = str_wrap(name, width = 30)
  )

go_order <- fgsea_f %>% filter(dataset == "GO") %>% arrange(NES) %>% pull(name)

fgsea_f <- fgsea_f %>%
  mutate(
    name    = factor(name, levels = c(str_wrap(pathway_order, width =30), go_order)),
    dataset = factor(dataset, levels = c("Risk", "GO"))
  )

lapply(fgsea_f$leadingEdge[grepl("Schizo",fgsea_f$pathway)],function(x) { 
