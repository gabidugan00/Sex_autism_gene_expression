cor_test <- cor.test(CCA1_weights$CCA1_Weight_Sex, CCA1_weights$CCA1_Weight_ASD, method = "pearson")
r_value <- round(cor_test$estimate, 2)
cor_label <- paste0("r = ", r_value)

CCA1_weights$Chromosome = "Autosomal"
CCA1_weights$Chromosome[CCA1_weights$gene %in% y_genes] = "Y-Chr"
CCA1_weights$Chromosome[CCA1_weights$gene %in% x_genes] = "X-Chr"
