#Labeling top points
CCA1_weights <- CCA1_weights %>%
  mutate(mean_score = (CCA1_weights$CCA1_Weight_Sex + CCA1_weights$CCA1_Weight_ASD) / 2)

CCA1_weights$color_value <- CCA1_weights$CCA1_Weight_Sex * CCA1_weights$CCA1_Weight_ASD
