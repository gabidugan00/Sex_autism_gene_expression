RCCA_function = function(dge1, dge2, logFCvector1, logFCvector2, celltype_colname1, celltype_colname2){
  
  #Genes must be tested in both datasets to be included in the analysis
  shared_genes <- intersect(dge1$gene,dge2$gene)
  
  #Reformat matrices to be only matching genes
  reshaped_data_1 <- dge1 %>%
    dplyr::filter(gene %in% shared_genes) %>%
    dplyr::select(gene, celltype_colname1, logFCvector1) %>%
    tidyr::pivot_wider(names_from = celltype_colname1, values_from = logFCvector1)
  
  matrix1 <- as.matrix(reshaped_data_1[, -1])  
  rownames(matrix1) <- reshaped_data_1$gene   
  
  reshaped_data_2 <- dge2 %>%
    dplyr::filter(gene %in% shared_genes) %>%
    dplyr::select(gene, celltype_colname2, logFCvector2) %>%
    tidyr::pivot_wider(names_from = celltype_colname2, values_from = logFCvector2)
  
  matrix2 <- as.matrix(reshaped_data_2[, -1]) 
  rownames(matrix2) <- reshaped_data_2$gene    
  
  matrix1 <- matrix1[rownames(matrix2),]
  
  # Grid optimization for lambda parameteres
  lambda1_grid <- seq(0.1, 1, by = 0.1)
  lambda2_grid <- seq(0.1, 1, by = 0.1)
  
  best_lambda1 <- 0
  best_lambda2 <- 0
  best_correlation <- -Inf
  
  table(rownames(matrix1) ==rownames(matrix2))
  
  for (lambda1 in lambda1_grid) {
    for (lambda2 in lambda2_grid) {
      rcca_result <- CCA::rcc(matrix1, matrix2, lambda1 = lambda1, lambda2 = lambda2)
      
      # For comparison use the mean correlationa cross the components
      correlation <- mean(rcca_result$cor)
      
      if (correlation > best_correlation) {
        best_lambda1 <- lambda1
        best_lambda2 <- lambda2
        best_correlation <- correlation
      }
    }
  }
  
  cat("Best lambda1:", best_lambda1, "\n")
  cat("Best lambda2:", best_lambda2, "\n")
  cat("Best canonical correlation:", best_correlation, "\n")
  
  optimal_rcca <- CCA::rcc(matrix1, matrix2, lambda1 = best_lambda1, lambda2 = best_lambda2)
  
  return(list = c("CCA_results" = optimal_rcca,
                  "lambda_values"= c(best_lambda1,best_lambda2)
  )
  )
  
}

